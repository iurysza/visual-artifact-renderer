{
  "version": "1.0.0",
  "limits": {
    "rawArtifactMaxBytes": 2097152,
    "topLevelNodes": 30,
    "datasets": 20,
    "totalNodes": 100,
    "nodeDepth": 8,
    "fileTreeItems": 500,
    "fileTreeDepth": 12,
    "fileSourceBytes": 524288,
    "aggregateFileSourceBytes": 1048576
  },
  "executionTrace": {
    "sourceLanguages": [
      "typescript",
      "tsx",
      "javascript",
      "jsx",
      "ruby"
    ]
  },
  "spec": {
    "slug": {
      "type": "string",
      "format": "kebab-case",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "optional": true
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "optional": true
    },
    "artifactType": {
      "enum": [
        "explainer",
        "dashboard",
        "review",
        "comparison",
        "report",
        "plan",
        "diagram",
        "idea"
      ],
      "optional": true
    },
    "topics": {
      "type": "array",
      "items": "non-empty string",
      "optional": true
    },
    "layout": {
      "type": {
        "enum": [
          "default",
          "grid"
        ]
      },
      "columns": {
        "enum": [
          1,
          2,
          3,
          4
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30
    }
  },
  "nodeTypes": [
    "alert",
    "area-chart",
    "radar-chart",
    "scatter-chart",
    "heatmap",
    "log",
    "definition-list",
    "diff",
    "donut-chart",
    "file-tree",
    "heading",
    "image",
    "pie-chart",
    "stepper",
    "text",
    "card",
    "metric",
    "stat-card",
    "badge",
    "button",
    "separator",
    "table",
    "data-table",
    "comparison-table",
    "chart",
    "mermaid",
    "svg-diagram",
    "flow",
    "timeline",
    "execution-trace",
    "code-block",
    "status-grid",
    "grid",
    "section",
    "tabs",
    "accordion",
    "prose",
    "claim-tree",
    "claim",
    "call-stack",
    "state-machine",
    "sequence-diagram",
    "box-diagram",
    "mockup",
    "wireframe",
    "decision",
    "change-stats",
    "quotes"
  ],
  "nodes": {
    "alert": {
      "description": "An alert message to call out important information.",
      "props": {
        "title": "string",
        "description": "string?",
        "variant": "\"default\" | \"destructive\"?",
        "tone": "\"info\" | \"warn\" | \"risk\" | \"ok\" | \"idea\"? — callout tone; wins over variant (destructive = risk)"
      },
      "children": false,
      "metadata": {
        "id": "string?"
      },
      "example": {
        "type": "alert",
        "props": {
          "title": "No secret-file filter yet",
          "description": "The sandbox stops path escapes, not reads of .env inside the root.",
          "tone": "risk"
        }
      }
    },
    "definition-list": {
      "description": "A compact list of terms and descriptions.",
      "props": {
        "items": "{ term: string, description: string }[]"
      },
      "children": false,
      "metadata": {
        "id": "string?"
      },
      "example": {
        "type": "definition-list",
        "props": {
          "items": [
            {
              "term": "Term",
              "description": "Description"
            }
          ]
        }
      }
    },
    "diff": {
      "description": "Code or text difference visualization. Accepts either a raw unified diff string (content) or a before/after pair.",
      "props": {
        "before": "string?",
        "after": "string?",
        "content": "string?",
        "language": "string?",
        "title": "string?",
        "defaultOpen": "boolean?",
        "mode": "\"unified\" | \"split\"?",
        "showLineNumbers": "boolean?",
        "indicators": "\"bars\" | \"plus-minus\" | \"none\"?",
        "highlightInline": "boolean?",
        "hunkSeparator": "\"default\" | \"custom\"?",
        "caption": "string?"
      },
      "children": false,
      "metadata": {
        "id": "string?"
      },
      "example": {
        "type": "diff",
        "props": {
          "content": "diff --git a/index.ts b/index.ts\n--- a/index.ts\n+++ b/index.ts\n@@ -1,3 +1,3 @@\n- old\n+ new\n",
          "language": "typescript",
          "title": "Sample diff"
        }
      }
    },
